<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
    body { 
        background-color: #2c3e50;
        color: white; 
    }
    .card { 
        background-color: #34495e; 
        color: white;
        border: none;
    }
    .table { 
        color: white; 
    }
    .table thead { 
        background-color: #1a252f; 
        color: white; 
    }
    .navbar { 
        background-color: #1a252f; 
        color: white; 
    }
</style>
</head>
<body>
    <nav class="navbar mb-4 justify-content-center"><h4 class="text-center">Employee Management Dashboard</h4></nav>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                <div class="card p-4">
                    <h5>Add New Employee</h5>
                    <form action="/add" method="POST">
                        <input name="name" class="form-control mb-2" placeholder="Name" required>
                        <input name="phone" class="form-control mb-2" placeholder="Phone" required>
                        <input name="role" class="form-control mb-2" placeholder="Role" required>
                        <input name="salary" class="form-control mb-3" placeholder="Salary" required>
                        <button class="btn btn-success w-100">Save Employee</button>
                    </form>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card p-4">
                    <h5>Employee Records</h5>
                    <table class="table table-striped table-hover mt-3">
                        <thead>
                            <tr><th>Name</th><th>Phone</th><th>Role</th><th>Salary</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <% employees.forEach((emp, index) => { %>
                            <tr>
                                <td><%= emp.name %></td>
                                <td><%= emp.phone %></td>
                                <td><%= emp.role %></td>
                                <td><%= emp.salary %></td>
                                
                                <td >
                                <a href="/view/<%= index %>" class="btn btn-info btn-sm">View</a>
                                <a href="/edit/<%= index %>" class="btn btn-warning btn-sm">Edit</a>
                                <form action="/delete/<%= index %>" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>