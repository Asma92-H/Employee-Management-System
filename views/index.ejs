<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            background: linear-gradient(135deg, #1e3c72, #2a5298); 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            color: white; 
        }
        .hero-section { padding: 50px; }
        .card { border-radius: 20px; padding: 20px; color: #333; }
    </style>
</head>
<body>
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Side -->
            <div class="col-md-6 hero-section">
                <h1>Employee Management System</h1>
                <a href="/auth/login" class="btn btn-light btn-lg mt-3">Go to Dashboard</a>
            </div>
            <!-- Right Side Image Card -->
            <div class="col-md-6">
                <div class="card shadow-lg">
                    <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=500" class="card-img-top" alt="Work">
                    <div class="card-body text-center">
                        <p class="card-text">A Case study of Foundation Polytechnic, Ikot Ekpene</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>