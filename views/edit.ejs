<!DOCTYPE html>
<html>
<head>
    <title>Edit Employee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white p-5">
    <h2>Edit Employee Details</h2>
    <div class="card p-4 bg-secondary">
        <form action="/edit/<%= index %>" method="POST">
            <input type="text" name="name" value="<%= employee.name %>" class="form-control mb-2" required>
            <input type="text" name="phone" value="<%= employee.phone %>" class="form-control mb-2" required>
            <input type="text" name="role" value="<%= employee.role %>" class="form-control mb-2" required>
            <input type="text" name="salary" value="<%= employee.salary %>" class="form-control mb-3" required>
            <button type="submit" class="btn btn-success">Update Employee</button>
            <a href="/auth/login" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>